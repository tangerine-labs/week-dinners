<div class="layout layout--col gap">
  <span class="title title--large lg:title--xlarge">Weekly Schedule</span>
  <div class="grid grid--cols-5 portrait:grid--cols-1 gap stretch-y">
    {% for day in weekdays %}
    <div class="col gap--small bg--gray-75 rounded--base">
      <span class="title title--large lg:title--xlarge">{{ day.day }}</span>

      <div class="item mt--large">
        <div class="content">
          <span class="label label--large label--underline">Snack</span>
          <span class="description description--large lg:description--xlarge" data-clamp="4">{{ day.snack }}</span>
        </div>
      </div>

      <div class="item mt--large">
        <div class="content">
          <span class="label label--large label--underline">Lunch</span>
          <span class="description description--large lg:description--xlarge" data-clamp="4">{{ day.lunch }}</span>
        </div>
      </div>

      <div class="item mt--large">
        <div class="content">
          <span class="label label--large label--underline">Dinner</span>
          <span class="description description--large lg:description--xlarge" data-clamp="4">{{ day.dinner }}</span>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
</div>
<div class="title_bar">
  <img class="image" src="https://trmnl.com/images/plugins/trmnl--render.svg" />
  <span class="title">Week Dinners</span>
</div>
